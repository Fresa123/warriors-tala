{
  "cuevana": {
    "enabled": true,
    "homeUrls": ["https://cuevana3i.bid"],
    "movieDetailPrefixes": ["/pelicula/", "/movie/"],
    "seriesDetailPrefixes": ["/serie/", "/series/", "/tv/"],
    "genreMoviePrefixes": ["/peliculas?genero=", "/movies?genre="],
    "genreSeriesPrefixes": ["/series?genero=", "/tv?genre="],
    "seasonPrefixes": ["/temporada-", "/season-"],
    "episodePrefixes": ["/episodio-", "/episode-"],
    "serverBlockTag": "<li class=\"tab-video-item\">",
    "serverItemRegex": "<li[^>]*data-server=\"([^\"]*)\"[^>]*>\\s*<span>(.*?)</span>",
    "languageRegex": "<div class=\"tab-item-name\">\\s*([^<]+)",
    "languageMap": {
      "Latino": "Latino",
      "Castellano": "Castellano",
      "Subtitulado": "Subtitulado",
      "Multilenguaje [CC]": "Multilenguaje [CC]"
    }
  },
  "poseidonhd": {
    "enabled": true,
    "homeUrl": "https://www.poseidonhd2.co",
    "useNextData": true,
    "videoKeys": {
      "movie": "thisMovie",
      "episode": "episode"
    },
    "languageMap": {
      "latino": "Latino",
      "spanish": "Castellano",
      "english": "Subtitulado"
    }
  }
}
